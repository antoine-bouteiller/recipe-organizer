{
  "name": "recipe-organizer",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "build": "vpr @recipe-organizer/web#build",
    "dev": "vpr --parallel --filter './apps/*' dev",
    "check": "vp check --fix",
    "test:coverage": "vp test run --coverage",
    "serve": "vp -C apps/web preview",
    "analyze": "ANALYZE=1 vp -C apps/web build",
    "db:migrate:local": "vpr @recipe-organizer/scripts#db:migrate:local",
    "db:migrate:remote": "drizzle-kit migrate",
    "db:dump": "wrangler d1 export recipe-organizer --config apps/web/server/wrangler.jsonc --remote --no-schema --output ./database.sql",
    "db:import": "wrangler d1 execute recipe-organizer --config apps/web/server/wrangler.jsonc --local --persist-to apps/web/.wrangler/state --file ./database.sql",
    "knip": "knip",
    "knip:production": "knip --production",
    "deploy": "vp -C apps/web exec void deploy --platform cloudflare",
    "storybook": "vpr @recipe-organizer/design-system#storybook",
    "storybook:build": "vpr @recipe-organizer/design-system#storybook:build"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@recipe-organizer/config": "workspace:*",
    "@recipe-organizer/oxlint": "workspace:*",
    "@storybook/addon-vitest": "catalog:",
    "@types/node": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "knip": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@12.8.1"
}
