{
  "name": "recipe-organizer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "dev": "vp dev",
    "check": "vp check --fix",
    "serve": "vp preview",
    "analyze": "ANALYZE=1 vp build",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "node ./scripts/apply-migration-local.ts",
    "db:migrate:remote": "drizzle-kit migrate",
    "db:dump": "rm -f database.sql && wrangler d1 export recipe-organizer --output=./database.sql --no-schema",
    "db:import": "wrangler d1 execute recipe-organizer --file ./database.sql",
    "knip": "knip"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@lexical/list": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-store": "0.11.1",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.3",
    "drizzle-orm": "1.0.0-rc.3",
    "lexical": "0.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@serwist/build": "9.5.12",
    "@serwist/vite": "9.5.12",
    "@serwist/window": "9.5.12",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router-devtools": "1.167.1",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/devtools": "0.6.3",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "1.0.0-rc.3",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "oxc-transform-react": "0.148.0",
    "serwist": "9.5.12",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "wrangler": "4.128.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@11.25.0"
}
