{
  "name": "recipe-organizer",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "build": "vp build",
    "dev": "vp dev",
    "check": "vp check --fix",
    "test:coverage": "vp test run --coverage",
    "serve": "vp preview",
    "analyze": "ANALYZE=1 vp build",
    "db:migrate:local": "vpr @recipe-organizer/scripts#db:migrate:local",
    "db:migrate:remote": "drizzle-kit migrate",
    "db:dump": "wrangler d1 export recipe-organizer --config packages/server/wrangler.jsonc --remote --no-schema --output ./database.sql",
    "db:import": "wrangler d1 execute recipe-organizer --config packages/server/wrangler.jsonc --local --persist-to .wrangler/state --file ./database.sql",
    "knip": "knip",
    "knip:production": "knip --production",
    "deploy": "vp exec void deploy --platform cloudflare",
    "storybook": "vpr @recipe-organizer/design-system#storybook",
    "storybook:build": "vpr @recipe-organizer/design-system#storybook:build"
  },
  "dependencies": {
    "@recipe-organizer/design-system": "workspace:*",
    "@recipe-organizer/server": "workspace:*",
    "@recipe-organizer/shared": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-store": "catalog:",
    "@void/react": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "void": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@recipe-organizer/config": "workspace:*",
    "@recipe-organizer/oxlint": "workspace:*",
    "@storybook/addon-vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "knip": "catalog:",
    "oxc-transform-react": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@12.8.1"
}
