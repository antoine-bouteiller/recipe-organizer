{
  "name": "recipe-organizer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run @recipe-organizer/web#build && vp run @recipe-organizer/api#build",
    "dev": "vp run --parallel --filter './apps/*' dev",
    "check": "vp check --fix",
    "serve": "vp run @recipe-organizer/api#serve",
    "analyze": "ANALYZE=1 vp -C apps/web build",
    "cf-typegen": "vp run @recipe-organizer/api#cf-typegen",
    "db:migrate:local": "pnpm --filter @recipe-organizer/scripts db:migrate:local",
    "db:migrate:remote": "drizzle-kit migrate",
    "db:dump": "vp run @recipe-organizer/scripts#db:dump",
    "db:import": "wrangler d1 execute recipe-organizer --config apps/api/wrangler.jsonc --local --persist-to .wrangler/state --file ./database.sql",
    "knip": "knip",
    "deploy": "vp run @recipe-organizer/api#deploy"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@recipe-organizer/config": "workspace:*",
    "@recipe-organizer/oxlint": "workspace:*",
    "@types/node": "25.9.6",
    "drizzle-kit": "1.0.0-rc.3",
    "knip": "6.35.1",
    "lefthook": "2.1.12",
    "typescript": "7.0.2",
    "vite-plus": "0.3.1",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@12.4.1"
}
