{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>antoine-bouteiller/renovate'],
  packageRules: [
    {
      // vite-plus bundles an exact Vitest; `vp migrate` realigns vite, vitest and @vitest/* together.
      description: 'Vite+ toolchain (updated via vp migrate)',
      enabled: false,
      matchPackageNames: ['vite-plus', 'vite', '@voidzero-dev/vite-plus-core', 'vitest', '@vitest/**'],
    },
  ],
}
