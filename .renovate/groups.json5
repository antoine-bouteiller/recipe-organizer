{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Cloudflare Group',
      groupName: 'cloudflare',
      matchPackageNames: ['wrangler', '@cloudflare/vite-plugin'],
    },
    {
      // Pinned to 1.0.0-rc.3: rc.4 broke `drizzle-kit migrate` on the d1-http driver.
      // sqlite-proxy's `values` executor sends method "all" (hitting D1's /query, which
      // returns keyed rows) while the migrations-table code reads rows positionally, so
      // every applied migration looks unmatched. Re-enable once upstream ships a fix.
      description: 'Drizzle Group',
      enabled: false,
      groupName: 'drizzle',
      matchPackageNames: ['drizzle-orm', 'drizzle-kit'],
      versioning: 'docker',
    },
    {
      description: 'Lexical Group',
      groupName: 'lexical',
      matchPackageNames: ['lexical', '@lexical/**'],
    },
    {
      description: 'React Group',
      groupName: 'react',
      matchPackageNames: ['react', 'react-dom', '@types/react', '@types/react-dom'],
    },
    {
      description: 'Serwist Group',
      groupName: 'serwist',
      matchPackageNames: ['serwist', '@serwist/**'],
    },
    {
      description: 'Tanstack Group',
      groupName: 'tanstack',
      matchPackageNames: ['@tanstack/**'],
    },
  ],
}
