{
  "extends": ["@recipe-organizer/config/tsconfig.base.json", "./.void/tsconfig.json"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite-plus/client", "void/env"],
    "jsx": "react-jsx",
    "paths": {
      "@client/*": ["./src/*"],
      "void/routes": ["./.void/routes.d.ts"]
    }
  },
  "include": [
    "src",
    "pages",
    "routes",
    "middleware",
    "env.ts",
    "packages/server/src/env.d.ts",
    "void.config.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    ".void/routes.d.ts"
  ]
}
