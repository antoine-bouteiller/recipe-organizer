{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "svelte", "vite-plus/client", "void/env"],
    "module": "esnext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*"],
      "@storybook-helpers/*": ["./.storybook/*"],
      "void/routes": ["./.void/routes.d.ts"]
    }
  },
  "files": [],
  "include": [
    "src",
    "pages",
    "routes",
    "middleware",
    "tools",
    ".storybook",
    "auth.ts",
    "env.ts",
    "void.config.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    ".void/routes.d.ts",
    ".void/db.d.ts",
    ".void/env.d.ts"
  ]
}
