{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": ["-lintignore"],
  "includeEntryExports": true,
  "workspaces": {
    "apps/web": {
      "entry": ["public/sw.js!", "{src,server}/**/*.test.ts", "routes/**/*.ts!", "middleware/**/*.ts!", "void.config.ts"]
    },
    "packages/shared": {
      "entry": ["src/**/*.test.ts"]
    },
    "packages/design-system": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}!", "!src/**/*.stories.*!"]
    },
    "packages/oxlint": {
      "entry": ["**/*.test.ts"]
    },
    "packages/scripts": {
      "entry": ["apply-migration-local.ts"]
    }
  },
  "husky": { "config": [".vite-hooks/pre-commit", ".vite-hooks/commit-msg"] },
  "ignoreDependencies": ["cloudflare"],
  "ignoreIssues": {
    "apps/web/{routes,middleware}/**/*.ts": ["exports"],
    "apps/web/void.config.ts": ["exports"]
  }
}
