{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": ["-lintignore"],
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": [
        "public/sw.js!",
        "src/**/*.test.{ts,tsx}",
        "pages/**/*.{ts,tsx}!",
        "routes/**/*.ts!",
        "middleware/**/*.ts!",
        "void.config.ts",
        "env.ts!"
      ]
    },
    "packages/server": {
      "entry": ["src/**/*.test.ts"]
    },
    "packages/shared": {
      "entry": ["src/**/*.test.ts"]
    },
    "packages/design-system": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}!", "!src/**/*.stories.*!"]
    },
    "packages/oxlint": {
      "entry": ["**/*.test.ts"]
    },
    "packages/scripts": {
      "entry": ["apply-migration-local.ts"]
    }
  },
  "husky": {
    "config": [".vite-hooks/pre-commit", ".vite-hooks/commit-msg"]
  },
  "ignoreDependencies": ["cloudflare", "oxc-transform-react"],
  "ignoreIssues": {
    "{routes,middleware}/**/*.ts": ["exports"],
    "pages/**/*.{ts,tsx}": ["exports", "types"],
    "{void.config,env}.ts": ["exports"]
  }
}
